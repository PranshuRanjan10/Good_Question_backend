# IronSense backend - local secrets. NOT committed (see .gitignore).
#
# You only need the TWO values below. Supabase's setup screen also shows a
# publishable key and a JWKS URL: both are for verifying end-user logins in a
# browser client. This backend has no end-user auth and talks to Supabase
# server-to-server, so neither is used. Leaving them out is deliberate: fewer
# secrets in the file, fewer things to leak.

# ---- Supabase (Settings -> API). Copy them exactly as the dashboard shows them.
SUPABASE_URL=https://your-project.supabase.co

# The "secret" key (starts sb_secret_...). Formerly called service_role.
# It bypasses row-level security, so it must never reach the frontend,
# a browser, or a commit.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# ---- Sync behaviour (app/sync/supabase.py)
# On by default when the two values above are set. It runs in the background: alerts never
# wait on Supabase, and if the network drops, rows queue locally and go on the next run.
# Keep false locally unless you want your laptop's test runs in the cloud tables.
SYNC_ENABLED=false

# Identifies this edge device in Supabase. Every synced row carries it, so two
# machines' local row #7 never collide. Change per device if you run more than one.
DEVICE_ID=edge-01

# Seconds between pushes. 60 keeps data safe on Render's free plan, which can restart any time.
SYNC_INTERVAL_S=60

# Rows per push. Small enough that a dropped connection costs little.
SYNC_BATCH_SIZE=200

# ---- Local database (leave unless you move the file)
# DATABASE_URL=sqlite:///./ironsense.db
