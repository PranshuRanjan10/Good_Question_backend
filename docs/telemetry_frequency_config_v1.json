{"config_version":"1.0","applies_to_contract":"telemetry_contract_v1.json","time_basis":"All intervals are in SIM time. With time_scale = 60, an interval of 60 s sim is sent every 1 s real.","backend_rule":"Backend keeps a latest-state store per machine and merges every incoming message into it. Models always read the merged state, so no message needs to repeat unchanged data.","tiers":[{"tier_id":"per_shift","interval":"once at operator login / shift start (about once per day), resent only if changed","msg_type":"shift_context","fields":["machine.machine_id","machine.model","machine.machine_type","machine.machine_age_yrs","operator.operator_id","operator.skill_level","operator.shift_start","site_id","site_map_version","hazards (static list: power lines, utilities, no-go zones, slopes)","daily_tasks (task_id, task_type, zone_id, planned_estimate_min, scheduled_start)","walkaround_checklist_result","weather_forecast_for_shift"],"real_world_source":"fleet database, operator login, site plan, weather API"},{"tier_id":"per_task","interval":"event: at task start and task completion","msg_type":"task_start / task_record","fields":["task_id","task_type","weather","operator_skill","machine_age_yrs","estimated_time_min","actual_time_min","ground_condition","ambient_temp_c","volume_moved_m3","idle_min_during_task","incidents_during_task"],"real_world_source":"task system plus backend aggregation","used_by":"task time estimator training data"},{"tier_id":"hourly","interval":"3600 s","msg_type":"interval_summary","fields":["engine.cumulative_hours","engine.cumulative_idle_hours","engine.cumulative_fuel_used_l","implement.cumulative_load_cycles","engine.def_level_pct","engine.battery_voltage_v","fuel_used_l (interval)","load_cycles (interval)","idling_time_min (interval)","seatbelt_compliance_pct (interval)","safety_alerts_count (interval)"],"real_world_source":"ECU counters via telematics","used_by":"anomaly detector baselines, matches organizers' sample table"},{"tier_id":"every_15_min","interval":"900 s","msg_type":"environment","fields":["environment.weather","environment.ambient_temp_c","environment.humidity_pct","environment.rain_mm_h","environment.wind_speed_kmh","environment.wind_gust_kmh","environment.visibility_m","environment.light","environment.dust_index","environment.ground_condition","engine.fuel_level_pct"],"real_world_source":"weather API, dust sensor, manual ground input, ECU","note":"weather changes and lightning are ALSO sent immediately as events"},{"tier_id":"every_60_s","interval":"60 s","msg_type":"status","fields":["engine.coolant_temp_c","implement.hydraulic_oil_temp_c","cab.cab_temp_c","operator.continuous_operation_min","operator.minutes_since_last_break","task.progress_pct","task.elapsed_min","task.volume_moved_m3","diagnostics.active_fault_codes"],"real_world_source":"ECU, cab sensors, backend-derived counters","note":"doubles as the heartbeat: sent even if nothing changed"},{"tier_id":"every_10_s","interval":"10 s","msg_type":"operation","fields":["engine.state","engine.rpm","engine.load_pct","engine.fuel_rate_lph","motion.position","motion.heading_deg","motion.ground_speed_kmh","motion.travel_direction","motion.parking_brake","motion.hydraulic_lockout","motion.travel_alarm_active","implement.work_mode","implement.hydraulic_pressure_bar","cab.seat_occupied","cab.seatbelt_fastened","cab.door_open","cab.controls_active"],"real_world_source":"CAN bus, GPS, seat and belt switches"},{"tier_id":"every_1_s_batched","interval":"sampled every 1 s, sent as one batch of 10 samples every 10 s","msg_type":"motion_batch","active_only_when":"engine.state != off","fields":["motion.pitch_deg","motion.roll_deg","motion.longitudinal_accel_ms2","implement.swing_angle_deg","implement.swing_rate_dps","implement.boom_angle_deg","implement.stick_angle_deg","implement.bucket_height_m","implement.bucket_payload_kg"],"real_world_source":"IMUs, payload system","used_by":"harsh events, fast swing, bucket-raised travel, load cycle detection"},{"tier_id":"proximity","interval":"edge device scans at 5 Hz; sends to backend at 1 Hz ONLY while an object is within 20 m, otherwise nothing","msg_type":"proximity","fields":["proximity[].object_id","proximity[].object_type","proximity[].role","proximity[].distance_m","proximity[].bearing_deg","proximity[].relative_speed_ms","proximity[].sensor","proximity[].detection_confidence"],"real_world_source":"radar, cameras, worker tags","note":"zone entry and exit are also sent immediately as events"},{"tier_id":"events","interval":"immediately when they happen","msg_type":"event","fields":["see enums.event_type in telemetry_contract_v1.json"],"examples":["seatbelt_unfastened","operator_left_seat","geofence_enter","harsh_brake","tilt_warning","fault_code","weather_change","lightning_nearby","refuel_start","manual_near_miss","task_complete"]}],"adaptive_rules":[{"when":"engine.state == off","then":"stop every_10_s, every_1_s_batched and proximity tiers; send status every 300 s; events still immediate (catches fuel theft, unauthorized start)"},{"when":"engine.state == idle for more than 2 min","then":"every_10_s tier slows to every 30 s"},{"when":"any person within 20 m","then":"proximity tier active at 1 Hz; operation tier speeds up to every 2 s"},{"when":"weather in [Storm, Fog] or light == night","then":"proximity trigger distance increases from 20 m to 35 m"},{"when":"connection lost","then":"edge buffers messages locally and uploads in order when back online; safety alerts keep working on the edge"}],"send_on_change_deadbands":{"comment":"Within the 10 s and 60 s tiers, a field is left out of the message if it changed less than this since it was last sent. The 60 s heartbeat still goes out.","engine.rpm":50,"engine.load_pct":5,"engine.fuel_rate_lph":0.5,"engine.coolant_temp_c":1,"implement.hydraulic_oil_temp_c":1,"implement.hydraulic_pressure_bar":10,"motion.position_m":0.5,"motion.heading_deg":3,"motion.ground_speed_kmh":0.3,"engine.fuel_level_pct":1,"cab.cab_temp_c":1},"example_messages":{"shift_context":{"msg_type":"shift_context","timestamp":"2025-05-01T07:30:00Z","site_id":"SITE01","site_map_version":"v3","machine":{"machine_id":"EXC001","model":"CAT 320","machine_type":"excavator","machine_age_yrs":4},"operator":{"operator_id":"OP1001","skill_level":"Intermediate","shift_start":"2025-05-01T07:30:00Z"},"daily_tasks":[{"task_id":"T002","task_type":"Trenching","zone_id":"ZONE_B","planned_estimate_min":45,"scheduled_start":"2025-05-01T08:00:00Z"}],"walkaround_checklist_result":{"completed":true,"issues":[]},"weather_forecast_for_shift":{"morning":"Cloudy","afternoon":"Rainy"}},"operation":{"msg_type":"operation","timestamp":"2025-05-01T10:14:10Z","machine_id":"EXC001","engine":{"state":"running","rpm":1650,"fuel_rate_lph":14.8},"motion":{"position":{"x_m":212.4,"y_m":88.1},"ground_speed_kmh":0},"implement":{"work_mode":"dig"},"cab":{"seat_occupied":true,"seatbelt_fastened":true}},"motion_batch":{"msg_type":"motion_batch","machine_id":"EXC001","start_timestamp":"2025-05-01T10:14:00Z","sample_interval_s":1,"fields":["pitch_deg","roll_deg","swing_angle_deg","swing_rate_dps","bucket_height_m","bucket_payload_kg"],"samples":[[4.2,1.1,30,15,1.2,1400],[4.2,1.1,35,18,1.2,1450],[4.3,1,52,22,2.6,1450],[4.3,1,70,20,3.1,1450],[4.2,1.1,85,12,3,1450],[4.2,1.1,90,0,2.1,300],[4.2,1.1,75,-18,2,0],[4.2,1.1,55,-21,1.8,0],[4.2,1.1,38,-16,1.3,0],[4.2,1.1,30,-6,0.9,400]]}}}
